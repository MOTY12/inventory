generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  DISABLED
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
  MANAGER
  BUYER
  SALES
  WAREHOUSE_CLERK
  FINANCE
  READ_ONLY
}

enum MembershipStatus {
  ACTIVE
  DEACTIVATED
}

enum WarehouseStatus {
  ACTIVE
  ARCHIVED
}

enum BranchStatus {
  ACTIVE
  ARCHIVED
}

model User {
  id                  String                   @id @default(uuid()) @db.Uuid
  email               String                   @unique @db.VarChar(320)
  emailNormalized     String                   @unique @map("email_normalized") @db.VarChar(320)
  passwordHash        String                   @map("password_hash") @db.VarChar(255)
  status              UserStatus               @default(PENDING_VERIFICATION)
  emailVerifiedAt     DateTime?                @map("email_verified_at") @db.Timestamptz(3)
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  refreshSessions     RefreshSession[]
  verificationTokens  EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  memberships         Membership[]
  sentInvitations     OrganizationInvitation[] @relation("InvitationSender")
  auditEvents         AuditEvent[]

  @@map("users")
}

model Organization {
  id          String                   @id @default(uuid()) @db.Uuid
  name        String                   @db.VarChar(160)
  slug        String                   @unique @db.VarChar(80)
  createdAt   DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships Membership[]
  invitations OrganizationInvitation[]
  sessions    RefreshSession[]
  warehouses  Warehouse[]
  branches    Branch[]
  auditEvents AuditEvent[]

  @@map("organizations")
}

model Membership {
  id              String                     @id @default(uuid()) @db.Uuid
  organizationId  String                     @map("organization_id") @db.Uuid
  userId          String                     @map("user_id") @db.Uuid
  role            MembershipRole             @default(MEMBER)
  status          MembershipStatus           @default(ACTIVE)
  createdAt       DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization    Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouseGrants MembershipWarehouseGrant[]

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@index([organizationId, status, role])
  @@map("memberships")
}

model Warehouse {
  id             String                     @id @default(uuid()) @db.Uuid
  organizationId String                     @map("organization_id") @db.Uuid
  branchId       String?                    @map("branch_id") @db.Uuid
  name           String                     @db.VarChar(160)
  code           String                     @db.VarChar(40)
  status         WarehouseStatus            @default(ACTIVE)
  createdAt      DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         Branch?                    @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  grants         MembershipWarehouseGrant[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@index([organizationId, status, name])
  @@index([organizationId, branchId, status])
  @@map("warehouses")
}

model Branch {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String       @db.VarChar(160)
  address        String?      @db.VarChar(500)
  status         BranchStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouses     Warehouse[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@index([organizationId, status, name])
  @@map("branches")
}

model AuditEvent {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  actorUserId    String       @map("actor_user_id") @db.Uuid
  entityType     String       @map("entity_type") @db.VarChar(80)
  entityId       String       @map("entity_id") @db.Uuid
  action         String       @db.VarChar(80)
  metadata       Json         @default("{}")
  occurredAt     DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User         @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, occurredAt])
  @@index([organizationId, entityType, entityId, occurredAt])
  @@map("audit_events")
}

model MembershipWarehouseGrant {
  organizationId String     @map("organization_id") @db.Uuid
  userId         String     @map("user_id") @db.Uuid
  warehouseId    String     @map("warehouse_id") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  membership     Membership @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade)
  warehouse      Warehouse  @relation(fields: [organizationId, warehouseId], references: [organizationId, id], onDelete: Cascade)

  @@id([organizationId, userId, warehouseId])
  @@index([organizationId, warehouseId])
  @@map("membership_warehouse_grants")
}

model OrganizationInvitation {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String         @map("organization_id") @db.Uuid
  invitedByUserId String         @map("invited_by_user_id") @db.Uuid
  emailNormalized String         @map("email_normalized") @db.VarChar(320)
  role            MembershipRole @default(MEMBER)
  tokenHash       String         @unique @map("token_hash") @db.Char(64)
  expiresAt       DateTime       @map("expires_at") @db.Timestamptz(3)
  acceptedAt      DateTime?      @map("accepted_at") @db.Timestamptz(3)
  revokedAt       DateTime?      @map("revoked_at") @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy       User           @relation("InvitationSender", fields: [invitedByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, emailNormalized, expiresAt])
  @@index([invitedByUserId, createdAt])
  @@map("organization_invitations")
}

model RefreshSession {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  familyId       String        @default(uuid()) @map("family_id") @db.Uuid
  tokenHash      String        @unique @map("token_hash") @db.Char(64)
  expiresAt      DateTime      @map("expires_at") @db.Timestamptz(3)
  revokedAt      DateTime?     @map("revoked_at") @db.Timestamptz(3)
  lastUsedAt     DateTime?     @map("last_used_at") @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([userId, expiresAt])
  @@index([userId, revokedAt])
  @@index([familyId, revokedAt])
  @@index([organizationId, userId])
  @@map("refresh_sessions")
}

model EmailVerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}
