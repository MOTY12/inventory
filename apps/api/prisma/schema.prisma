generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  DISABLED
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
  MANAGER
  BUYER
  SALES
  WAREHOUSE_CLERK
  FINANCE
  READ_ONLY
}

enum MembershipStatus {
  ACTIVE
  DEACTIVATED
}

enum WarehouseStatus {
  ACTIVE
  ARCHIVED
}

enum BranchStatus {
  ACTIVE
  ARCHIVED
}

enum CatalogStatus {
  ACTIVE
  ARCHIVED
}

enum ProductType {
  STOCKED
  NON_STOCK
}

enum StockMovementType {
  OPENING_BALANCE
  RECEIPT
  SALE_FULFILLMENT
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT
  REVERSAL
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
}

enum StockAdjustmentStatus {
  DRAFT
  POSTED
}

enum StockTransferStatus {
  DRAFT
  SUBMITTED
  IN_TRANSIT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum CustomerType {
  BUSINESS
  INDIVIDUAL
}

enum CustomerStatus {
  ACTIVE
  ARCHIVED
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
}

enum InventoryReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
}

model User {
  id                  String                   @id @default(uuid()) @db.Uuid
  email               String                   @unique @db.VarChar(320)
  emailNormalized     String                   @unique @map("email_normalized") @db.VarChar(320)
  passwordHash        String                   @map("password_hash") @db.VarChar(255)
  status              UserStatus               @default(PENDING_VERIFICATION)
  emailVerifiedAt     DateTime?                @map("email_verified_at") @db.Timestamptz(3)
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  refreshSessions     RefreshSession[]
  verificationTokens  EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  memberships         Membership[]
  sentInvitations     OrganizationInvitation[] @relation("InvitationSender")
  auditEvents         AuditEvent[]

  @@map("users")
}

model Organization {
  id                         String                        @id @default(uuid()) @db.Uuid
  name                       String                        @db.VarChar(160)
  slug                       String                        @unique @db.VarChar(80)
  createdAt                  DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships                Membership[]
  invitations                OrganizationInvitation[]
  sessions                   RefreshSession[]
  warehouses                 Warehouse[]
  branches                   Branch[]
  auditEvents                AuditEvent[]
  categories                 Category[]
  units                      Unit[]
  products                   Product[]
  stockMovements             StockMovement[]
  inventoryBalances          InventoryBalance[]
  idempotencyRecords         IdempotencyRecord[]
  outboxEvents               OutboxEvent[]
  stockAdjustments           StockAdjustment[]
  suppliers                  Supplier[]
  customers                  Customer[]
  purchaseOrders             PurchaseOrder[]
  purchaseOrderSequence      PurchaseOrderSequence?
  stockTransferSequence      StockTransferSequence?
  stockTransfers             StockTransfer[]
  stockTransferDispatches    StockTransferDispatch[]
  stockTransferReceipts      StockTransferReceipt[]
  stockTransferStatusHistory StockTransferStatusHistory[]
  stockTransferLines         StockTransferLine[]
  stockTransferDispatchLines StockTransferDispatchLine[]
  stockTransferReceiptLines  StockTransferReceiptLine[]
  salesOrders                SalesOrder[]
  salesOrderSequence         SalesOrderSequence?
  salesOrderStatusHistory    SalesOrderStatusHistory[]
  salesOrderLines            SalesOrderLine[]
  inventoryReservations      InventoryReservation[]
  reservationHistory         InventoryReservationHistory[]
  salesFulfillments          SalesFulfillment[]
  salesFulfillmentLines      SalesFulfillmentLine[]

  @@map("organizations")
}

model Membership {
  id                         String                        @id @default(uuid()) @db.Uuid
  organizationId             String                        @map("organization_id") @db.Uuid
  userId                     String                        @map("user_id") @db.Uuid
  role                       MembershipRole                @default(MEMBER)
  status                     MembershipStatus              @default(ACTIVE)
  createdAt                  DateTime                      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization               Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                       User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouseGrants            MembershipWarehouseGrant[]
  stockMovements             StockMovement[]
  stockAdjustments           StockAdjustment[]
  purchaseOrders             PurchaseOrder[]
  goodsReceipts              GoodsReceipt[]
  createdStockTransfers      StockTransfer[]               @relation("TransferCreator")
  dispatchedStockTransfers   StockTransferDispatch[]
  receivedStockTransfers     StockTransferReceipt[]
  stockTransferStatusChanges StockTransferStatusHistory[]
  createdSalesOrders         SalesOrder[]
  salesOrderStatusChanges    SalesOrderStatusHistory[]
  reservationHistory         InventoryReservationHistory[]
  postedSalesFulfillments    SalesFulfillment[]

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@index([organizationId, status, role])
  @@map("memberships")
}

model Warehouse {
  id                    String                     @id @default(uuid()) @db.Uuid
  organizationId        String                     @map("organization_id") @db.Uuid
  branchId              String?                    @map("branch_id") @db.Uuid
  name                  String                     @db.VarChar(160)
  code                  String                     @db.VarChar(40)
  status                WarehouseStatus            @default(ACTIVE)
  createdAt             DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization          Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch                Branch?                    @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  grants                MembershipWarehouseGrant[]
  stockMovements        StockMovement[]
  inventoryBalances     InventoryBalance[]
  stockAdjustments      StockAdjustment[]
  sourceTransfers       StockTransfer[]            @relation("TransferSourceWarehouse")
  destinationTransfers  StockTransfer[]            @relation("TransferDestinationWarehouse")
  purchaseOrders        PurchaseOrder[]
  salesOrders           SalesOrder[]
  inventoryReservations InventoryReservation[]
  salesFulfillments     SalesFulfillment[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@index([organizationId, status, name])
  @@index([organizationId, branchId, status])
  @@map("warehouses")
}

model Branch {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String       @db.VarChar(160)
  address        String?      @db.VarChar(500)
  status         BranchStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouses     Warehouse[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@index([organizationId, status, name])
  @@map("branches")
}

model Category {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  parentId       String?       @map("parent_id") @db.Uuid
  name           String        @db.VarChar(120)
  status         CatalogStatus @default(ACTIVE)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent         Category?     @relation("CategoryTree", fields: [organizationId, parentId], references: [organizationId, id], onDelete: Restrict)
  children       Category[]    @relation("CategoryTree")
  products       Product[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@index([organizationId, parentId, status, name])
  @@map("categories")
}

model Unit {
  id                 String                  @id @default(uuid()) @db.Uuid
  organizationId     String                  @map("organization_id") @db.Uuid
  code               String                  @db.VarChar(24)
  name               String                  @db.VarChar(80)
  precision          Int                     @default(0) @db.SmallInt
  status             CatalogStatus           @default(ACTIVE)
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization       Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  baseForProducts    Product[]               @relation("ProductBaseUnit")
  conversions        ProductUnitConversion[]
  purchaseOrderLines PurchaseOrderLine[]
  salesOrderLines    SalesOrderLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@index([organizationId, status, name])
  @@map("units")
}

model Product {
  id                    String                  @id @default(uuid()) @db.Uuid
  organizationId        String                  @map("organization_id") @db.Uuid
  name                  String                  @db.VarChar(180)
  sku                   String                  @db.VarChar(80)
  skuNormalized         String                  @map("sku_normalized") @db.VarChar(80)
  barcode               String?                 @db.VarChar(100)
  barcodeNormalized     String?                 @map("barcode_normalized") @db.VarChar(100)
  description           String?                 @db.VarChar(2000)
  type                  ProductType             @default(STOCKED)
  categoryId            String?                 @map("category_id") @db.Uuid
  baseUnitId            String                  @map("base_unit_id") @db.Uuid
  trackInventory        Boolean                 @default(true) @map("track_inventory")
  defaultCost           Decimal?                @map("default_cost") @db.Decimal(20, 4)
  costCurrency          String?                 @map("cost_currency") @db.Char(3)
  defaultSalePrice      Decimal?                @map("default_sale_price") @db.Decimal(20, 4)
  saleCurrency          String?                 @map("sale_currency") @db.Char(3)
  status                CatalogStatus           @default(ACTIVE)
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization          Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category              Category?               @relation(fields: [organizationId, categoryId], references: [organizationId, id], onDelete: Restrict)
  baseUnit              Unit                    @relation("ProductBaseUnit", fields: [organizationId, baseUnitId], references: [organizationId, id], onDelete: Restrict)
  unitConversions       ProductUnitConversion[]
  stockMovements        StockMovement[]
  inventoryBalances     InventoryBalance[]
  stockAdjustments      StockAdjustment[]
  purchaseOrderLines    PurchaseOrderLine[]
  stockTransferLines    StockTransferLine[]
  salesOrderLines       SalesOrderLine[]
  inventoryReservations InventoryReservation[]
  salesFulfillmentLines SalesFulfillmentLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, skuNormalized])
  @@unique([organizationId, barcodeNormalized])
  @@index([organizationId, status, name])
  @@index([organizationId, categoryId, status])
  @@index([organizationId, type, status])
  @@map("products")
}

model ProductUnitConversion {
  organizationId String  @map("organization_id") @db.Uuid
  productId      String  @map("product_id") @db.Uuid
  unitId         String  @map("unit_id") @db.Uuid
  baseQuantity   Decimal @map("base_quantity") @db.Decimal(20, 6)
  product        Product @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Cascade)
  unit           Unit    @relation(fields: [organizationId, unitId], references: [organizationId, id], onDelete: Restrict)

  @@id([organizationId, productId, unitId])
  @@index([organizationId, unitId])
  @@map("product_unit_conversions")
}

model StockMovement {
  id                   String                     @id @default(uuid()) @db.Uuid
  organizationId       String                     @map("organization_id") @db.Uuid
  warehouseId          String                     @map("warehouse_id") @db.Uuid
  productId            String                     @map("product_id") @db.Uuid
  documentType         String                     @map("document_type") @db.VarChar(48)
  documentId           String                     @map("document_id") @db.Uuid
  documentLineId       String?                    @map("document_line_id") @db.Uuid
  movementType         StockMovementType          @map("movement_type")
  quantityDelta        Decimal                    @map("quantity_delta") @db.Decimal(20, 6)
  costPerBaseUnit      Decimal?                   @map("cost_per_base_unit") @db.Decimal(20, 4)
  costCurrency         String?                    @map("cost_currency") @db.Char(3)
  occurredAt           DateTime                   @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actorUserId          String                     @map("actor_user_id") @db.Uuid
  reversalOfId         String?                    @map("reversal_of_id") @db.Uuid
  createdAt            DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  organization         Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  warehouse            Warehouse                  @relation(fields: [organizationId, warehouseId], references: [organizationId, id], onDelete: Restrict)
  product              Product                    @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  actorMembership      Membership                 @relation(fields: [organizationId, actorUserId], references: [organizationId, userId], onDelete: Restrict)
  reversalOf           StockMovement?             @relation("MovementReversal", fields: [organizationId, reversalOfId], references: [organizationId, id], onDelete: Restrict)
  reversals            StockMovement[]            @relation("MovementReversal")
  adjustment           StockAdjustment?           @relation("AdjustmentMovement")
  goodsReceiptLine     GoodsReceiptLine?          @relation("ReceiptMovement")
  transferDispatchLine StockTransferDispatchLine? @relation("TransferDispatchMovement")
  transferReceiptLine  StockTransferReceiptLine?  @relation("TransferReceiptMovement")
  salesFulfillmentLine SalesFulfillmentLine?      @relation("SalesFulfillmentMovement")

  @@unique([organizationId, id])
  @@index([organizationId, productId, occurredAt, id])
  @@index([organizationId, warehouseId, occurredAt, id])
  @@index([organizationId, documentType, documentId])
  @@index([organizationId, reversalOfId])
  @@map("stock_movements")
}

model InventoryBalance {
  organizationId String       @map("organization_id") @db.Uuid
  warehouseId    String       @map("warehouse_id") @db.Uuid
  productId      String       @map("product_id") @db.Uuid
  onHand         Decimal      @default(0) @map("on_hand") @db.Decimal(20, 6)
  reserved       Decimal      @default(0) @db.Decimal(20, 6)
  inTransit      Decimal      @default(0) @map("in_transit") @db.Decimal(20, 6)
  averageCost    Decimal?     @map("average_cost") @db.Decimal(20, 4)
  costCurrency   String?      @map("cost_currency") @db.Char(3)
  version        Int          @default(0)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouse      Warehouse    @relation(fields: [organizationId, warehouseId], references: [organizationId, id], onDelete: Restrict)
  product        Product      @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)

  @@id([organizationId, warehouseId, productId])
  @@index([organizationId, productId, warehouseId])
  @@index([organizationId, warehouseId, onHand])
  @@map("inventory_balances")
}

model StockAdjustment {
  id               String                @id @default(uuid()) @db.Uuid
  organizationId   String                @map("organization_id") @db.Uuid
  warehouseId      String                @map("warehouse_id") @db.Uuid
  productId        String                @map("product_id") @db.Uuid
  reason           String                @db.VarChar(500)
  systemQuantity   Decimal               @map("system_quantity") @db.Decimal(20, 6)
  countedQuantity  Decimal               @map("counted_quantity") @db.Decimal(20, 6)
  status           StockAdjustmentStatus @default(DRAFT)
  createdByUserId  String                @map("created_by_user_id") @db.Uuid
  postedMovementId String?               @unique @map("posted_movement_id") @db.Uuid
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  postedAt         DateTime?             @map("posted_at") @db.Timestamptz(3)
  organization     Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  warehouse        Warehouse             @relation(fields: [organizationId, warehouseId], references: [organizationId, id], onDelete: Restrict)
  product          Product               @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  createdBy        Membership            @relation(fields: [organizationId, createdByUserId], references: [organizationId, userId], onDelete: Restrict)
  postedMovement   StockMovement?        @relation("AdjustmentMovement", fields: [organizationId, postedMovementId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, postedMovementId])
  @@index([organizationId, warehouseId, status, createdAt])
  @@index([organizationId, productId, createdAt])
  @@map("stock_adjustments")
}

model StockTransferSequence {
  organizationId String       @id @map("organization_id") @db.Uuid
  nextNumber     BigInt       @default(1) @map("next_number")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("stock_transfer_sequences")
}

model StockTransfer {
  id                     String                       @id @default(uuid()) @db.Uuid
  organizationId         String                       @map("organization_id") @db.Uuid
  sourceWarehouseId      String                       @map("source_warehouse_id") @db.Uuid
  destinationWarehouseId String                       @map("destination_warehouse_id") @db.Uuid
  number                 String                       @db.VarChar(40)
  status                 StockTransferStatus          @default(DRAFT)
  note                   String?                      @db.VarChar(500)
  createdByUserId        String                       @map("created_by_user_id") @db.Uuid
  createdAt              DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)
  submittedAt            DateTime?                    @map("submitted_at") @db.Timestamptz(3)
  dispatchedAt           DateTime?                    @map("dispatched_at") @db.Timestamptz(3)
  completedAt            DateTime?                    @map("completed_at") @db.Timestamptz(3)
  organization           Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sourceWarehouse        Warehouse                    @relation("TransferSourceWarehouse", fields: [organizationId, sourceWarehouseId], references: [organizationId, id], onDelete: Restrict)
  destinationWarehouse   Warehouse                    @relation("TransferDestinationWarehouse", fields: [organizationId, destinationWarehouseId], references: [organizationId, id], onDelete: Restrict)
  createdBy              Membership                   @relation("TransferCreator", fields: [organizationId, createdByUserId], references: [organizationId, userId], onDelete: Restrict)
  lines                  StockTransferLine[]
  dispatch               StockTransferDispatch?
  receipts               StockTransferReceipt[]
  statusHistory          StockTransferStatusHistory[]

  @@unique([organizationId, id])
  @@unique([organizationId, number])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, sourceWarehouseId, status, createdAt])
  @@index([organizationId, destinationWarehouseId, status, createdAt])
  @@map("stock_transfers")
}

model StockTransferLine {
  id                String                      @id @default(uuid()) @db.Uuid
  organizationId    String                      @map("organization_id") @db.Uuid
  transferId        String                      @map("transfer_id") @db.Uuid
  productId         String                      @map("product_id") @db.Uuid
  requestedQuantity Decimal                     @map("requested_quantity") @db.Decimal(20, 6)
  createdAt         DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  organization      Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  transfer          StockTransfer               @relation(fields: [organizationId, transferId], references: [organizationId, id], onDelete: Cascade)
  product           Product                     @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  dispatchLines     StockTransferDispatchLine[]
  receiptLines      StockTransferReceiptLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, transferId, productId])
  @@index([organizationId, productId, createdAt])
  @@map("stock_transfer_lines")
}

model StockTransferDispatch {
  id                 String                      @id @default(uuid()) @db.Uuid
  organizationId     String                      @map("organization_id") @db.Uuid
  transferId         String                      @map("transfer_id") @db.Uuid
  dispatchedByUserId String                      @map("dispatched_by_user_id") @db.Uuid
  dispatchedAt       DateTime                    @default(now()) @map("dispatched_at") @db.Timestamptz(3)
  organization       Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  transfer           StockTransfer               @relation(fields: [organizationId, transferId], references: [organizationId, id], onDelete: Restrict)
  dispatchedBy       Membership                  @relation(fields: [organizationId, dispatchedByUserId], references: [organizationId, userId], onDelete: Restrict)
  lines              StockTransferDispatchLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, transferId])
  @@map("stock_transfer_dispatches")
}

model StockTransferDispatchLine {
  id              String                @id @default(uuid()) @db.Uuid
  organizationId  String                @map("organization_id") @db.Uuid
  dispatchId      String                @map("dispatch_id") @db.Uuid
  transferLineId  String                @map("transfer_line_id") @db.Uuid
  quantity        Decimal               @db.Decimal(20, 6)
  movementId      String                @unique @map("movement_id") @db.Uuid
  costPerBaseUnit Decimal?              @map("cost_per_base_unit") @db.Decimal(20, 4)
  costCurrency    String?               @map("cost_currency") @db.Char(3)
  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  dispatch        StockTransferDispatch @relation(fields: [organizationId, dispatchId], references: [organizationId, id], onDelete: Cascade)
  transferLine    StockTransferLine     @relation(fields: [organizationId, transferLineId], references: [organizationId, id], onDelete: Restrict)
  movement        StockMovement         @relation("TransferDispatchMovement", fields: [organizationId, movementId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, transferLineId])
  @@unique([organizationId, movementId])
  @@map("stock_transfer_dispatch_lines")
}

model StockTransferReceipt {
  id               String                     @id @default(uuid()) @db.Uuid
  organizationId   String                     @map("organization_id") @db.Uuid
  transferId       String                     @map("transfer_id") @db.Uuid
  idempotencyKey   String                     @map("idempotency_key") @db.VarChar(160)
  note             String?                    @db.VarChar(500)
  receivedByUserId String                     @map("received_by_user_id") @db.Uuid
  receivedAt       DateTime                   @default(now()) @map("received_at") @db.Timestamptz(3)
  organization     Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  transfer         StockTransfer              @relation(fields: [organizationId, transferId], references: [organizationId, id], onDelete: Restrict)
  receivedBy       Membership                 @relation(fields: [organizationId, receivedByUserId], references: [organizationId, userId], onDelete: Restrict)
  lines            StockTransferReceiptLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, transferId, receivedAt])
  @@map("stock_transfer_receipts")
}

model StockTransferReceiptLine {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  receiptId      String               @map("receipt_id") @db.Uuid
  transferLineId String               @map("transfer_line_id") @db.Uuid
  quantity       Decimal              @db.Decimal(20, 6)
  movementId     String               @unique @map("movement_id") @db.Uuid
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  receipt        StockTransferReceipt @relation(fields: [organizationId, receiptId], references: [organizationId, id], onDelete: Cascade)
  transferLine   StockTransferLine    @relation(fields: [organizationId, transferLineId], references: [organizationId, id], onDelete: Restrict)
  movement       StockMovement        @relation("TransferReceiptMovement", fields: [organizationId, movementId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, movementId])
  @@index([organizationId, transferLineId, receiptId])
  @@map("stock_transfer_receipt_lines")
}

model StockTransferStatusHistory {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  transferId     String               @map("transfer_id") @db.Uuid
  fromStatus     StockTransferStatus? @map("from_status")
  toStatus       StockTransferStatus  @map("to_status")
  actorUserId    String               @map("actor_user_id") @db.Uuid
  note           String?              @db.VarChar(500)
