generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  DISABLED
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
  MANAGER
  BUYER
  SALES
  WAREHOUSE_CLERK
  FINANCE
  READ_ONLY
}

enum MembershipStatus {
  ACTIVE
  DEACTIVATED
}

enum WarehouseStatus {
  ACTIVE
  ARCHIVED
}

enum BranchStatus {
  ACTIVE
  ARCHIVED
}

enum CatalogStatus {
  ACTIVE
  ARCHIVED
}

enum ProductType {
  STOCKED
  NON_STOCK
}

enum StockMovementType {
  OPENING_BALANCE
  RECEIPT
  SALE_FULFILLMENT
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT
  REVERSAL
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
}

enum StockAdjustmentStatus {
  DRAFT
  POSTED
}

model User {
  id                  String                   @id @default(uuid()) @db.Uuid
  email               String                   @unique @db.VarChar(320)
  emailNormalized     String                   @unique @map("email_normalized") @db.VarChar(320)
  passwordHash        String                   @map("password_hash") @db.VarChar(255)
  status              UserStatus               @default(PENDING_VERIFICATION)
  emailVerifiedAt     DateTime?                @map("email_verified_at") @db.Timestamptz(3)
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  refreshSessions     RefreshSession[]
  verificationTokens  EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  memberships         Membership[]
  sentInvitations     OrganizationInvitation[] @relation("InvitationSender")
  auditEvents         AuditEvent[]

  @@map("users")
}

model Organization {
  id                 String                   @id @default(uuid()) @db.Uuid
  name               String                   @db.VarChar(160)
  slug               String                   @unique @db.VarChar(80)
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships        Membership[]
  invitations        OrganizationInvitation[]
  sessions           RefreshSession[]
  warehouses         Warehouse[]
  branches           Branch[]
  auditEvents        AuditEvent[]
  categories         Category[]
  units              Unit[]
  products           Product[]
  stockMovements     StockMovement[]
  inventoryBalances  InventoryBalance[]
  idempotencyRecords IdempotencyRecord[]
  outboxEvents       OutboxEvent[]
  stockAdjustments   StockAdjustment[]
  suppliers          Supplier[]

  @@map("organizations")
}

model Membership {
  id               String                     @id @default(uuid()) @db.Uuid
  organizationId   String                     @map("organization_id") @db.Uuid
  userId           String                     @map("user_id") @db.Uuid
  role             MembershipRole             @default(MEMBER)
  status           MembershipStatus           @default(ACTIVE)
  createdAt        DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization     Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user             User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouseGrants  MembershipWarehouseGrant[]
  stockMovements   StockMovement[]
  stockAdjustments StockAdjustment[]

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@index([organizationId, status, role])
  @@map("memberships")
}

model Warehouse {
  id                String                     @id @default(uuid()) @db.Uuid
  organizationId    String                     @map("organization_id") @db.Uuid
  branchId          String?                    @map("branch_id") @db.Uuid
  name              String                     @db.VarChar(160)
  code              String                     @db.VarChar(40)
  status            WarehouseStatus            @default(ACTIVE)
  createdAt         DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization      Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch            Branch?                    @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  grants            MembershipWarehouseGrant[]
  stockMovements    StockMovement[]
  inventoryBalances InventoryBalance[]
  stockAdjustments  StockAdjustment[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@index([organizationId, status, name])
  @@index([organizationId, branchId, status])
  @@map("warehouses")
}

model Branch {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String       @db.VarChar(160)
  address        String?      @db.VarChar(500)
  status         BranchStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouses     Warehouse[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@index([organizationId, status, name])
  @@map("branches")
}

model Category {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  parentId       String?       @map("parent_id") @db.Uuid
  name           String        @db.VarChar(120)
  status         CatalogStatus @default(ACTIVE)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent         Category?     @relation("CategoryTree", fields: [organizationId, parentId], references: [organizationId, id], onDelete: Restrict)
  children       Category[]    @relation("CategoryTree")
  products       Product[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
  @@index([organizationId, parentId, status, name])
  @@map("categories")
}

model Unit {
  id              String                  @id @default(uuid()) @db.Uuid
  organizationId  String                  @map("organization_id") @db.Uuid
  code            String                  @db.VarChar(24)
  name            String                  @db.VarChar(80)
  precision       Int                     @default(0) @db.SmallInt
  status          CatalogStatus           @default(ACTIVE)
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  baseForProducts Product[]               @relation("ProductBaseUnit")
  conversions     ProductUnitConversion[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@index([organizationId, status, name])
  @@map("units")
}

model Product {
  id                String                  @id @default(uuid()) @db.Uuid
  organizationId    String                  @map("organization_id") @db.Uuid
  name              String                  @db.VarChar(180)
  sku               String                  @db.VarChar(80)
  skuNormalized     String                  @map("sku_normalized") @db.VarChar(80)
  barcode           String?                 @db.VarChar(100)
  barcodeNormalized String?                 @map("barcode_normalized") @db.VarChar(100)
  description       String?                 @db.VarChar(2000)
  type              ProductType             @default(STOCKED)
  categoryId        String?                 @map("category_id") @db.Uuid
  baseUnitId        String                  @map("base_unit_id") @db.Uuid
  trackInventory    Boolean                 @default(true) @map("track_inventory")
  defaultCost       Decimal?                @map("default_cost") @db.Decimal(20, 4)
  costCurrency      String?                 @map("cost_currency") @db.Char(3)
  defaultSalePrice  Decimal?                @map("default_sale_price") @db.Decimal(20, 4)
  saleCurrency      String?                 @map("sale_currency") @db.Char(3)
  status            CatalogStatus           @default(ACTIVE)
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization      Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category          Category?               @relation(fields: [organizationId, categoryId], references: [organizationId, id], onDelete: Restrict)
  baseUnit          Unit                    @relation("ProductBaseUnit", fields: [organizationId, baseUnitId], references: [organizationId, id], onDelete: Restrict)
  unitConversions   ProductUnitConversion[]
  stockMovements    StockMovement[]
  inventoryBalances InventoryBalance[]
  stockAdjustments  StockAdjustment[]

  @@unique([organizationId, id])
  @@unique([organizationId, skuNormalized])
  @@unique([organizationId, barcodeNormalized])
  @@index([organizationId, status, name])
  @@index([organizationId, categoryId, status])
  @@index([organizationId, type, status])
  @@map("products")
}

model ProductUnitConversion {
  organizationId String  @map("organization_id") @db.Uuid
  productId      String  @map("product_id") @db.Uuid
  unitId         String  @map("unit_id") @db.Uuid
  baseQuantity   Decimal @map("base_quantity") @db.Decimal(20, 6)
  product        Product @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Cascade)
  unit           Unit    @relation(fields: [organizationId, unitId], references: [organizationId, id], onDelete: Restrict)

  @@id([organizationId, productId, unitId])
  @@index([organizationId, unitId])
  @@map("product_unit_conversions")
}

model StockMovement {
  id              String            @id @default(uuid()) @db.Uuid
  organizationId  String            @map("organization_id") @db.Uuid
  warehouseId     String            @map("warehouse_id") @db.Uuid
  productId       String            @map("product_id") @db.Uuid
  documentType    String            @map("document_type") @db.VarChar(48)
  documentId      String            @map("document_id") @db.Uuid
  documentLineId  String?           @map("document_line_id") @db.Uuid
  movementType    StockMovementType @map("movement_type")
  quantityDelta   Decimal           @map("quantity_delta") @db.Decimal(20, 6)
  costPerBaseUnit Decimal?          @map("cost_per_base_unit") @db.Decimal(20, 4)
  costCurrency    String?           @map("cost_currency") @db.Char(3)
  occurredAt      DateTime          @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actorUserId     String            @map("actor_user_id") @db.Uuid
  reversalOfId    String?           @map("reversal_of_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  warehouse       Warehouse         @relation(fields: [organizationId, warehouseId], references: [organizationId, id], onDelete: Restrict)
  product         Product           @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  actorMembership Membership        @relation(fields: [organizationId, actorUserId], references: [organizationId, userId], onDelete: Restrict)
  reversalOf      StockMovement?    @relation("MovementReversal", fields: [organizationId, reversalOfId], references: [organizationId, id], onDelete: Restrict)
  reversals       StockMovement[]   @relation("MovementReversal")
  adjustment      StockAdjustment?  @relation("AdjustmentMovement")

  @@unique([organizationId, id])
  @@index([organizationId, productId, occurredAt, id])
  @@index([organizationId, warehouseId, occurredAt, id])
  @@index([organizationId, documentType, documentId])
  @@index([organizationId, reversalOfId])
  @@map("stock_movements")
}

model InventoryBalance {
  organizationId String       @map("organization_id") @db.Uuid
  warehouseId    String       @map("warehouse_id") @db.Uuid
  productId      String       @map("product_id") @db.Uuid
  onHand         Decimal      @default(0) @map("on_hand") @db.Decimal(20, 6)
  reserved       Decimal      @default(0) @db.Decimal(20, 6)
  inTransit      Decimal      @default(0) @map("in_transit") @db.Decimal(20, 6)
  averageCost    Decimal?     @map("average_cost") @db.Decimal(20, 4)
  costCurrency   String?      @map("cost_currency") @db.Char(3)
  version        Int          @default(0)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouse      Warehouse    @relation(fields: [organizationId, warehouseId], references: [organizationId, id], onDelete: Restrict)
  product        Product      @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)

  @@id([organizationId, warehouseId, productId])
  @@index([organizationId, productId, warehouseId])
  @@index([organizationId, warehouseId, onHand])
  @@map("inventory_balances")
}

model StockAdjustment {
  id               String                @id @default(uuid()) @db.Uuid
  organizationId   String                @map("organization_id") @db.Uuid
  warehouseId      String                @map("warehouse_id") @db.Uuid
  productId        String                @map("product_id") @db.Uuid
  reason           String                @db.VarChar(500)
  systemQuantity   Decimal               @map("system_quantity") @db.Decimal(20, 6)
  countedQuantity  Decimal               @map("counted_quantity") @db.Decimal(20, 6)
  status           StockAdjustmentStatus @default(DRAFT)
  createdByUserId  String                @map("created_by_user_id") @db.Uuid
  postedMovementId String?               @unique @map("posted_movement_id") @db.Uuid
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  postedAt         DateTime?             @map("posted_at") @db.Timestamptz(3)
  organization     Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  warehouse        Warehouse             @relation(fields: [organizationId, warehouseId], references: [organizationId, id], onDelete: Restrict)
  product          Product               @relation(fields: [organizationId, productId], references: [organizationId, id], onDelete: Restrict)
  createdBy        Membership            @relation(fields: [organizationId, createdByUserId], references: [organizationId, userId], onDelete: Restrict)
  postedMovement   StockMovement?        @relation("AdjustmentMovement", fields: [organizationId, postedMovementId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, postedMovementId])
  @@index([organizationId, warehouseId, status, createdAt])
  @@index([organizationId, productId, createdAt])
  @@map("stock_adjustments")
}

model Supplier {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  name           String        @db.VarChar(180)
  nameNormalized String        @map("name_normalized") @db.VarChar(180)
  contactName    String?       @map("contact_name") @db.VarChar(180)
  email          String?       @db.VarChar(320)
  phone          String?       @db.VarChar(40)
  website        String?       @db.VarChar(500)
  addressLine1   String?       @map("address_line_1") @db.VarChar(240)
  addressLine2   String?       @map("address_line_2") @db.VarChar(240)
  city           String?       @db.VarChar(120)
  region         String?       @db.VarChar(120)
  postalCode     String?       @map("postal_code") @db.VarChar(32)
  countryCode    String?       @map("country_code") @db.Char(2)
  termsNotes     String?       @map("terms_notes") @db.VarChar(1000)
  status         CatalogStatus @default(ACTIVE)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, id])
  @@unique([organizationId, nameNormalized])
  @@index([organizationId, status, name])
  @@index([organizationId, email])
  @@map("suppliers")
}

model IdempotencyRecord {
  organizationId String            @map("organization_id") @db.Uuid
  key            String            @db.VarChar(160)
  payloadHash    String            @map("payload_hash") @db.Char(64)
  status         IdempotencyStatus @default(IN_PROGRESS)
  resultType     String?           @map("result_type") @db.VarChar(48)
  resultId       String?           @map("result_id") @db.Uuid
  response       Json?
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt    DateTime?         @map("completed_at") @db.Timestamptz(3)
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, key])
  @@index([organizationId, status, createdAt])
  @@map("idempotency_records")
}

model OutboxEvent {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  eventType      String       @map("event_type") @db.VarChar(100)
  aggregateType  String       @map("aggregate_type") @db.VarChar(80)
  aggregateId    String       @map("aggregate_id") @db.Uuid
  payload        Json
  occurredAt     DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(3)
  publishedAt    DateTime?    @map("published_at") @db.Timestamptz(3)
  attemptCount   Int          @default(0) @map("attempt_count")
  lastError      String?      @map("last_error") @db.VarChar(1000)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, publishedAt, occurredAt])
  @@index([organizationId, aggregateType, aggregateId, occurredAt])
  @@map("outbox_events")
}

model AuditEvent {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  actorUserId    String       @map("actor_user_id") @db.Uuid
  entityType     String       @map("entity_type") @db.VarChar(80)
  entityId       String       @map("entity_id") @db.Uuid
  action         String       @db.VarChar(80)
  metadata       Json         @default("{}")
  occurredAt     DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User         @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, occurredAt])
  @@index([organizationId, entityType, entityId, occurredAt])
  @@map("audit_events")
}

model MembershipWarehouseGrant {
  organizationId String     @map("organization_id") @db.Uuid
  userId         String     @map("user_id") @db.Uuid
  warehouseId    String     @map("warehouse_id") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  membership     Membership @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade)
  warehouse      Warehouse  @relation(fields: [organizationId, warehouseId], references: [organizationId, id], onDelete: Cascade)

  @@id([organizationId, userId, warehouseId])
  @@index([organizationId, warehouseId])
  @@map("membership_warehouse_grants")
}

model OrganizationInvitation {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String         @map("organization_id") @db.Uuid
  invitedByUserId String         @map("invited_by_user_id") @db.Uuid
  emailNormalized String         @map("email_normalized") @db.VarChar(320)
  role            MembershipRole @default(MEMBER)
  tokenHash       String         @unique @map("token_hash") @db.Char(64)
  expiresAt       DateTime       @map("expires_at") @db.Timestamptz(3)
  acceptedAt      DateTime?      @map("accepted_at") @db.Timestamptz(3)
  revokedAt       DateTime?      @map("revoked_at") @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy       User           @relation("InvitationSender", fields: [invitedByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, emailNormalized, expiresAt])
  @@index([invitedByUserId, createdAt])
  @@map("organization_invitations")
}

model RefreshSession {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  familyId       String        @default(uuid()) @map("family_id") @db.Uuid
  tokenHash      String        @unique @map("token_hash") @db.Char(64)
  expiresAt      DateTime      @map("expires_at") @db.Timestamptz(3)
  revokedAt      DateTime?     @map("revoked_at") @db.Timestamptz(3)
  lastUsedAt     DateTime?     @map("last_used_at") @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([userId, expiresAt])
  @@index([userId, revokedAt])
  @@index([familyId, revokedAt])
  @@index([organizationId, userId])
  @@map("refresh_sessions")
}

model EmailVerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}
