{
  "name": "inventory-saas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@inventory/web",
    "dev:api": "npm run start:dev --workspace=@inventory/api",
    "build": "npm run build --workspace=@inventory/shared && npm run build --workspace=@inventory/api && npm run build --workspace=@inventory/web",
    "lint": "eslint apps packages scripts",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css,json}\" \"packages/**/*.{ts,tsx,json,mjs}\" \"scripts/**/*.mjs\" \"*.{json,mjs}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css,json}\" \"packages/**/*.{ts,tsx,json,mjs}\" \"scripts/**/*.mjs\" \"*.{json,mjs}\"",
    "validate:env": "npm run build --workspace=@inventory/shared && node scripts/validate-local-env.mjs",
    "test": "npm run build --workspace=@inventory/shared && npm run build --workspace=@inventory/api && node --test packages/shared/test/*.test.mjs apps/api/test/*.test.mjs",
    "typecheck": "npm run build --workspace=@inventory/shared && npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "@types/pg": "8.15.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "prettier": "^3.9.10",
    "prisma": "7.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
