# Local development only. These values are not production credentials.
POSTGRES_USER=inventory
POSTGRES_PASSWORD=local-dev-only-change-me
POSTGRES_DB=inventory_dev
POSTGRES_PORT=5432

REDIS_PASSWORD=local-dev-only-change-me
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

S3_REGION=us-east-1
S3_ENDPOINT=http://127.0.0.1:9090
S3_ACCESS_KEY_ID=inventory-local-access
S3_SECRET_ACCESS_KEY=inventory-local-secret-change-before-deploy
S3_BUCKET=inventory-local
S3_PORT=9090
REPORT_EXPORT_TTL_HOURS=24
REPORT_EXPORT_MAX_ROWS=1000000
DATABASE_URL=postgresql://inventory:local-dev-only-change-me@localhost:5432/inventory_dev?schema=public
JWT_ACCESS_SECRET=local-development-only-secret-change-before-deploy-123456
WEB_ORIGIN=http://localhost:3000
